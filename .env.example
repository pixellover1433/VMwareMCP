# VMware MCP Server - Environment Configuration
#
# Copy this file to .env and fill in your values.
# The server scans VMREST_HOST_1, VMREST_HOST_2, ... sequentially.
# It stops when the next VMREST_HOST_N is not set.

# ── Host 1 ──────────────────────────────────────────────
VMREST_HOST_1=localhost
VMREST_PORT_1=8697
VMREST_USERNAME_1=your_username
VMREST_PASSWORD_1=your_password
VMREST_VERIFY_SSL_1=false
VMREST_ALIAS_1=my-workstation

# ── Host 2 (optional) ──────────────────────────────────
#VMREST_HOST_2=192.168.1.100
#VMREST_PORT_2=8697
#VMREST_USERNAME_2=your_username
#VMREST_PASSWORD_2=your_password
#VMREST_VERIFY_SSL_2=false
#VMREST_ALIAS_2=dev-server

# ── Host 3 (optional) ──────────────────────────────────
#VMREST_HOST_3=10.0.0.50
#VMREST_PORT_3=8697
#VMREST_USERNAME_3=your_username
#VMREST_PASSWORD_3=your_password
#VMREST_VERIFY_SSL_3=false
#VMREST_ALIAS_3=prod-server
