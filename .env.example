# VMware MCP Server - Environment Configuration
#
# Copy this file to .env and fill in your values.

# ── vmrest host ──────────────────────────────────────────
VMREST_HOST=localhost
VMREST_PORT=8697
VMREST_USERNAME=your_username
VMREST_PASSWORD=your_password
VMREST_VERIFY_SSL=false

# ── vmcli (local snapshot queries) ───────────────────────
# Full path to vmcli.exe. Used by snapshot tools that query the local
# VMware Workstation installation directly. Only needed when the MCP
# server runs on the same host as VMware Workstation.
VMCLI_PATH=C:\Program Files (x86)\VMware\VMware Workstation\vmcli.exe
